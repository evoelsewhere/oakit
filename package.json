{
  "name": "@evoelsewhere/oakit",
  "version": "0.0.0",
  "description": "Agent-ready tools for reading, understanding, editing, and generating PowerPoint, Excel, and Word documents.",
  "license": "MIT",
  "keywords": [
    "office",
    "json",
    "pptx",
    "xlsx",
    "docx",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "bin": {
    "oakit": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pptx": {
      "types": "./dist/pptx/index.d.ts",
      "import": "./dist/pptx/index.js",
      "require": "./dist/pptx/index.cjs"
    },
    "./pptx/node": {
      "types": "./dist/pptx/node.d.ts",
      "import": "./dist/pptx/node.js",
      "require": "./dist/pptx/node.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:corpus": "node scripts/corpus/fetch-pptx-corpus.mjs && vitest run --config vitest.corpus.config.ts",
    "test:corpus:large": "node scripts/corpus/fetch-pptx-corpus.mjs --include-large && vitest run --config vitest.corpus.config.ts",
    "test:mutation": "stryker run && pnpm test:mutation:audit",
    "test:mutation:audit": "pnpm test:mutation:scope:complete && node scripts/check-mutation-report.mjs",
    "test:mutation:scope": "node scripts/check-mutation-scope.mjs",
    "test:mutation:scope:complete": "node scripts/check-mutation-scope.mjs --complete",
    "test:package": "node scripts/check-package.mjs",
    "test:portable:memory": "pnpm build && node --expose-gc scripts/reliability/check-pptx-portable-memory.mjs",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:mutation:scope:complete && pnpm test && pnpm build && pnpm test:package",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evoelsewhere/oakit.git"
  },
  "bugs": {
    "url": "https://github.com/evoelsewhere/oakit/issues"
  },
  "homepage": "https://github.com/evoelsewhere/oakit#readme",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "jszip": "^3.10.1",
    "saxes": "^6.0.0",
    "tinycolor2": "^1.6.0",
    "txml": "^5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^24.13.3",
    "@types/tinycolor2": "^1.4.6",
    "@vitest/browser": "3.2.7",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "fast-check": "^4.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
